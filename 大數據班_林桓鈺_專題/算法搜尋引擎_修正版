def normalize_text(value):
    """統一轉成大寫字串，方便中英文搜尋與比對。"""
    if pd.isna(value):
        return ""
    return str(value).strip().upper()


def split_keywords(query):
    return [word for word in re.split(r"\s+", str(query).strip()) if word]


def load_excel(path, required_columns):
    df = pd.read_excel(path)
    missing = [column for column in required_columns if column not in df.columns]
    if missing:
        raise ValueError(f"{path} 缺少欄位: {', '.join(missing)}")
    return df


def load_data():
    products = load_excel(PRODUCT_PATH, ["name", "brand", "link", "price", "color"])
    color_weights = load_excel(COLOR_WEIGHT_PATH, ["color", "加權"])
    brand_weights = load_excel(BRAND_WEIGHT_PATH, ["brand", "加權"])

    products = products.copy()
    products["name"] = products["name"].fillna("").astype(str)
    products["brand"] = products["brand"].fillna("").astype(str).str.strip()
    products["color"] = products["color"].fillna("").astype(str).str.strip()

    color_weights = color_weights.copy()
    color_weights["color"] = color_weights["color"].fillna("").astype(str).str.strip()
    color_weights["加權"] = pd.to_numeric(color_weights["加權"], errors="coerce").fillna(0)

    brand_weights = brand_weights.copy()
    brand_weights["brand"] = brand_weights["brand"].fillna("").astype(str).str.strip()
    brand_weights["加權"] = pd.to_numeric(brand_weights["加權"], errors="coerce").fillna(0)

    return products, color_weights, brand_weights


def build_brand_associations(transactions, min_support=0.4):
    cleaned_transactions = [
        sorted({normalize_text(item) for item in transaction if normalize_text(item)})
        for transaction in transactions
    ]

    if not cleaned_transactions:
        return pd.DataFrame(columns=["brand", "related_brand", "support"])

    if apriori is not None and TransactionEncoder is not None:
        encoder = TransactionEncoder()
        encoded = encoder.fit(cleaned_transactions).transform(cleaned_transactions)
        basket_df = pd.DataFrame(encoded, columns=encoder.columns_)
        frequent_itemsets = apriori(basket_df, min_support=min_support, use_colnames=True)

        rows = []
        for _, row in frequent_itemsets.iterrows():
            items = sorted(row["itemsets"])
            if len(items) < 2:
                continue
            for brand_a, brand_b in combinations(items, 2):
                rows.append(
                    {"brand": brand_a, "related_brand": brand_b, "support": row["support"]}
                )
                rows.append(
                    {"brand": brand_b, "related_brand": brand_a, "support": row["support"]}
                )
        return pd.DataFrame(rows, columns=["brand", "related_brand", "support"])

    pair_counts = Counter()
    for transaction in cleaned_transactions:
        for brand_a, brand_b in combinations(transaction, 2):
            pair_counts[(brand_a, brand_b)] += 1

    rows = []
    total = len(cleaned_transactions)
    for (brand_a, brand_b), count in pair_counts.items():
        support = count / total
        if support < min_support:
            continue
        rows.append({"brand": brand_a, "related_brand": brand_b, "support": support})
        rows.append({"brand": brand_b, "related_brand": brand_a, "support": support})
    return pd.DataFrame(rows, columns=["brand", "related_brand", "support"])


def exact_values_in_query(query, values):
    query_norm = normalize_text(query)
    matched = []
    for value in values:
        value_norm = normalize_text(value)
        if value_norm and value_norm in query_norm:
            matched.append(value)
    return matched


def build_query_weights(query, color_weights, brand_weights, associations):
    keywords = split_keywords(query)
    query_colors = exact_values_in_query(query, color_weights["color"])
    query_brands = exact_values_in_query(query, brand_weights["brand"])

    color_weights = color_weights.copy()
    brand_weights = brand_weights.copy()

    color_norm = color_weights["color"].map(normalize_text)
    brand_norm = brand_weights["brand"].map(normalize_text)

    for color in query_colors:
        color_weights.loc[color_norm == normalize_text(color), "加權"] += 10

    query_brand_norms = {normalize_text(brand) for brand in query_brands}
    for brand in query_brand_norms:
        brand_weights.loc[brand_norm == brand, "加權"] += 20

    if not associations.empty and query_brand_norms:
        related = set(
            associations.loc[
                associations["brand"].isin(query_brand_norms), "related_brand"
            ].dropna()
        )
        for brand in related:
            brand_weights.loc[brand_norm == normalize_text(brand), "加權"] += 10

    return keywords, color_weights, brand_weights


def keyword_search(query, documents):
    results = {}
    query_norm = normalize_text(query)
    for doc_id, doc_text in documents.items():
        if query_norm and query_norm in normalize_text(doc_text):
            results[doc_id] = doc_text
    return results


def search_products(query, products):
    keywords = split_keywords(query)
    if not keywords:
        return products.iloc[0:0].copy()

    name_series = products["name"].fillna("").astype(str)
    brand_norm = products["brand"].map(normalize_text)
    color_norm = products["color"].map(normalize_text)

    mask = pd.Series(False, index=products.index)
    for keyword in keywords:
        keyword_norm = normalize_text(keyword)
        mask |= name_series.str.contains(keyword, case=False, regex=False, na=False)
        mask |= brand_norm.str.contains(keyword_norm, regex=False, na=False)
        mask |= color_norm.eq(keyword_norm)

    return products.loc[mask].copy()


def calculate_keyword_score(products, keywords):
    scores = pd.Series(0, index=products.index, dtype=float)
    name_series = products["name"].fillna("").astype(str)
    brand_norm = products["brand"].map(normalize_text)
    color_norm = products["color"].map(normalize_text)

    for keyword in keywords:
        keyword_norm = normalize_text(keyword)
        scores += name_series.str.contains(keyword, case=False, regex=False, na=False).astype(int) * 5
        scores += brand_norm.str.contains(keyword_norm, regex=False, na=False).astype(int) * 8
        scores += color_norm.eq(keyword_norm).astype(int) * 8

    return scores


def rank_products(query, top_n=30):
    keywords, color_weights, brand_weights = build_query_weights(
        query, COLOR_WEIGHTS, BRAND_WEIGHTS, BRAND_ASSOCIATIONS
    )
    results = search_products(query, PRODUCTS)
    if results.empty:
        return results.assign(weighted=pd.Series(dtype=float))

    color_scores = color_weights.rename(columns={"加權": "color_weight"})
    brand_scores = brand_weights.rename(columns={"加權": "brand_weight"})

    ranked = results.merge(color_scores, how="left", on="color")
    ranked = ranked.merge(brand_scores, how="left", on="brand")
    ranked["keyword_score"] = calculate_keyword_score(ranked, keywords).values
    ranked["weighted"] = (
        ranked["color_weight"].fillna(0)
        + ranked["brand_weight"].fillna(0)
        + ranked["keyword_score"].fillna(0)
    )

    ranked = ranked.drop_duplicates(subset=["link"], keep="first")
    ranked = ranked.sort_values(
        by=["weighted", "price"], ascending=[False, True], ignore_index=True
    )
    return ranked.head(top_n)


